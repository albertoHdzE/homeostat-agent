# DeepSeek API key used by the online LLM backend (required).
# Get one at https://platform.deepseek.com/ and copy this file to `.env`.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional overrides (defaults shown).
# HOMEOSTAT_LLM_BACKEND=deepseek          # startup online backend: deepseek | claude | openai (cycle live with F10)
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=high          # low | high | max
# HOMEOSTAT_CLAUDE_MODEL=claude-opus-5-5  # uses your Claude Code login, no API key
# HOMEOSTAT_CLAUDE_EFFORT=high            # low | medium | high | xhigh | max
# HOMEOSTAT_OPENAI_MODEL=gpt-6-luna      # uses your Codex ChatGPT login, no API key
# HOMEOSTAT_OPENAI_EFFORT=high           # low | medium | high | xhigh | max
